<Window x:Class="LazySend.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LazySend.App"
        Title="Lazy Send" Width="980" Height="680" MinWidth="720" MinHeight="460"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}">
    <Grid Margin="24">
        <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                   VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Grid>
</Window>
