<Window x:Class="LazySend.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LazySend.App"
        Title="Lazy Send" Width="1020" Height="700" MinWidth="760" MinHeight="480"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The paired phones. -->
        <Border Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="16,20,16,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="Settings" ui:Icon.Glyph="&#xE713;" HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}" Click="Settings_Click" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Lazy Send" Style="{StaticResource SubtitleText}" />
                <TextBlock DockPanel.Dock="Top" Text="Phones" Style="{StaticResource SectionHeaderText}" Margin="0,20,0,8" />
                <Button DockPanel.Dock="Bottom" x:Name="PairButton" Content="Pair a phone" ui:Icon.Glyph="&#xE8EA;" Margin="0,8,0,16"
                        Style="{StaticResource AccentIconTextButtonStyle}" HorizontalAlignment="Stretch" Click="Pair_Click" />
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Phones on USB" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8" />
                    <TextBlock x:Name="UsbHintText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding UsbPhones}" AutomationProperties.Name="Phones on USB">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Button Content="Import photos and videos" ui:Icon.Glyph="&#xE896;" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                            Style="{StaticResource IconTextButtonStyle}" IsEnabled="{Binding CanImport}" Click="ImportUsb_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Copies new photos and videos to the receive folder, skipping what is already there. On an iPhone, choose Settings > Photos > Transfer to Mac or PC > Keep Originals first; Automatic converts HEIC photos on the fly and is slower." />
                </StackPanel>
                <TextBlock x:Name="NoPhonesText" DockPanel.Dock="Top" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap"
                           Text="No phone is paired yet. Pair one to send things between it and this PC." />
                <ListBox x:Name="PhonesList" ItemsSource="{Binding Phones}" SelectionChanged="PhonesList_SelectionChanged"
                         Style="{StaticResource NavListBoxStyle}" AutomationProperties.Name="Paired phones">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,2">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" ui:Icon.Glyph="&#xE711;"
                                        ToolTip="Remove this phone" AutomationProperties.Name="Remove this phone" Click="RemovePhone_Click" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LastSeen}" Style="{StaticResource CaptionText}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="24,20,24,16">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="TargetText" Style="{StaticResource SubtitleText}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NoticeText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <!-- Compose: text, files, and a drop hint. -->
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="ComposeBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto" PreviewKeyDown="Compose_PreviewKeyDown" TextChanged="Compose_TextChanged"
                             AutomationProperties.Name="Text or link to send" />
                    <TextBlock x:Name="ComposeHint" IsHitTestVisible="False" Margin="12,9,0,0" Style="{StaticResource BodyText}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Type or paste text or a link. Drop files anywhere in this window." />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button Content="Send files" ui:Icon.Glyph="&#xE8E5;" Style="{StaticResource IconTextButtonStyle}" Click="SendFiles_Click" />
                    <Button x:Name="SendButton" Content="Send" Margin="8,0,0,0" MinWidth="80" Style="{StaticResource AccentButtonStyle}" Click="Send_Click" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
                <ListBox x:Name="TimelineList" ItemsSource="{Binding Timeline}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False"
                         AutomationProperties.Name="What arrived and what was sent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:TimelineItem}">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" Margin="0,0,12,0" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Top"
                                            Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Style="{StaticResource GlyphText}" Text="{Binding Glyph}" FontSize="24" Width="56" VerticalAlignment="Top"
                                               Margin="0,0,12,0" Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Heading}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding Body, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" Padding="0" Margin="0,4,0,0"
                                                 Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <Button Content="Copy" ui:Icon.Glyph="&#xE8C8;" Style="{StaticResource SubtleButtonStyle}" Click="Copy_Click"
                                                Visibility="{Binding CanCopy, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="{Binding OpenLabel}" ui:Icon.Glyph="&#xE8A7;" Style="{StaticResource SubtleButtonStyle}" Click="Open_Click"
                                                Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Show in folder" ui:Icon.Glyph="&#xE838;" Style="{StaticResource SubtleButtonStyle}" Click="ShowInFolder_Click"
                                                Visibility="{Binding CanShowFolder, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Stop" ui:Icon.Glyph="&#xE71A;" Style="{StaticResource SubtleButtonStyle}" Click="StopImport_Click"
                                                Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Cancel" ui:Icon.Glyph="&#xE711;" Style="{StaticResource SubtleButtonStyle}" Click="CancelItem_Click"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                           Text="Nothing yet. What your phone sends shows up here, and so does what you send to it." />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
