<Window x:Class="LazySend.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LazySend.App"
        Title="Settings" Width="560" Height="480" MinWidth="440" MinHeight="400"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}" Padding="24,14,24,18">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" MinWidth="96" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock x:Name="FooterStatus" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
        <StackPanel Margin="24,20,24,16">
            <TextBlock Text="Settings" Style="{StaticResource SubtitleText}" />

            <TextBlock x:Name="FolderLabel" Text="Received files go to" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,8" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Default" Margin="4,0,0,0" Style="{StaticResource SubtleButtonStyle}" Click="DefaultFolder_Click" />
                <Button DockPanel.Dock="Right" Content="Choose…" Margin="4,0,0,0" Click="ChooseFolder_Click" />
                <TextBox x:Name="FolderBox" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         AutomationProperties.LabeledBy="{Binding ElementName=FolderLabel}" />
            </DockPanel>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Each phone gets its own folder inside it, and photos from a gallery sync go to Gallery, sorted by month." />

            <CheckBox x:Name="CopyBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,20,0,0" Content="Copy received text to the clipboard"
                      Checked="Copy_Changed" Unchecked="Copy_Changed" />
            <CheckBox x:Name="StartBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0" Content="Start with Windows (in the tray)"
                      Checked="Start_Changed" Unchecked="Start_Changed" />
            <CheckBox x:Name="SendToBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0" Content="Add Lazy Send to Explorer's Send to menu"
                      Checked="SendTo_Changed" Unchecked="SendTo_Changed" />
        </StackPanel>
    </DockPanel>
</Window>
