<Window x:Class="LazySend.App.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LazySend.App"
        Title="Connect to a computer"
        Width="560" Height="640" MinWidth="460" MinHeight="520"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}" Padding="24,14,24,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ConnectButton" Content="Connect" MinWidth="96" IsDefault="True" Style="{StaticResource AccentButtonStyle}"
                            Click="Connect_Click" />
                    <Button x:Name="CloseButton" Content="Close" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="FooterStatus" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12">
            <TextBlock Text="Connect to a computer" Style="{StaticResource SubtitleText}" />
            <TextBlock Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="On the other computer, open Lazy Send and choose Pair a phone. It shows a code and a link. Nothing goes through the internet: the two computers talk directly, encrypted." />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="24,0,24,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" x:Name="LookButton" Content="Look again" ui:Icon.Glyph="&#xE72C;"
                            Style="{StaticResource SubtleButtonStyle}" Click="Look_Click" />
                    <TextBlock Text="Computers nearby" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="LookText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                <ListBox x:Name="Nearby" MinHeight="96" MaxHeight="200" DisplayMemberPath="Name" Style="{StaticResource NavListBoxStyle}"
                         AutomationProperties.Name="Computers nearby" />

                <TextBlock x:Name="CodeLabel" Text="Code or link" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,4" />
                <TextBlock Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap"
                           Text="Choose the computer above and type the code it shows, like 7KQ2-M9XD. Or paste its link (lazysend://pair?...) and no choice is needed." />
                <TextBox x:Name="CodeBox" Margin="0,8,0,0" FontSize="16" FontFamily="Cascadia Mono, Consolas"
                         AutomationProperties.LabeledBy="{Binding ElementName=CodeLabel}" />

                <Border x:Name="MatchCard" Style="{StaticResource CardStyle}" Visibility="Collapsed" Margin="0,16,0,0" Padding="16,12"
                        BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock x:Name="MatchText" Style="{StaticResource SubtitleText}" FontFamily="Cascadia Mono, Consolas" />
                        <TextBlock x:Name="MatchHelp" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
