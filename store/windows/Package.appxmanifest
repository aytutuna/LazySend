<?xml version="1.0" encoding="utf-8"?>
<!-- The three values marked PartnerCenter come from Partner Center, Product identity. scripts/make_msix.ps1
     replaces them and the version when it packs; the file stays as it is in the repository. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 uap5 desktop rescap">

  <Identity Name="PartnerCenterIdentityName"
            Publisher="CN=PartnerCenterPublisher"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Lazy Send</DisplayName>
    <PublisherDisplayName>PartnerCenterPublisherDisplayName</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="LazySend" Executable="LazySend.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Lazy Send"
                          Description="Send text, links, files and photos between your PC and your phone."
                          BackgroundColor="#0067C0"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square71x71Logo="Assets\Square71x71Logo.png"
                         Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- The quotes keep an argument with spaces in it one argument. -->
        <uap3:Extension Category="windows.protocol" EntryPoint="Windows.FullTrustApplication" Executable="LazySend.exe">
          <uap3:Protocol Name="lazysend" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Lazy Send</uap:DisplayName>
          </uap3:Protocol>
        </uap3:Extension>
        <!-- Start with Windows. The app turns it on and off through the StartupTask API; the setting stays off until it does. -->
        <desktop:Extension Category="windows.startupTask" Executable="LazySend.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="LazySendStartup" Enabled="false" DisplayName="Lazy Send" />
        </desktop:Extension>
        <!-- What the Send to shortcut starts. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="LazySend.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="LazySend.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
